#: controllers/SecurityCheck.php:317
msgid "Outdated Plugins"
msgstr ""

#: controllers/SecurityCheck.php:321
msgid "One or more plugins have updates available. Plugin updates frequently include patches for known security vulnerabilities. Attackers actively scan for sites running outdated plugin versions with known exploits. <br /><br />Keeping all plugins up to date is one of the most effective and simplest ways to protect your site."
msgstr ""

#: controllers/SecurityCheck.php:322
msgid "Go to Dashboard > Plugins and update all plugins to their latest versions."
msgstr ""

#: controllers/SecurityCheck.php:325
msgid "Abandoned Plugins Detected"
msgstr ""

#: controllers/SecurityCheck.php:329
msgid "One or more installed plugins have not been updated by their developers in over 12 months. Abandoned plugins no longer receive security patches and may contain unpatched vulnerabilities that attackers can exploit."
msgstr ""

#: controllers/SecurityCheck.php:330
msgid "Review the plugins that have not been updated recently and replace them with actively maintained alternatives from the WordPress directory."
msgstr ""

#: controllers/SecurityCheck.php:333
msgid "Outdated Themes"
msgstr ""

#: controllers/SecurityCheck.php:337
msgid "One or more themes have updates available. Theme updates include security patches and bug fixes for known vulnerabilities. <br /><br />Even inactive themes can be exploited if they contain vulnerable code, since their files are still accessible on the server. Keep all installed themes up to date."
msgstr ""

#: controllers/SecurityCheck.php:338
msgid "Go to Dashboard > Appearance and update all themes to their latest versions. Remove any unused themes."
msgstr ""

#: controllers/SecurityCheck.php:341
msgid "Default Database Prefix"
msgstr ""

#: controllers/SecurityCheck.php:345
msgid "Your database is using the default <strong>wp_</strong> table prefix. Automated SQL injection attacks commonly target this default prefix. Using a custom prefix adds an additional barrier against mass-targeted attacks that assume standard WordPress table names."
msgstr ""

#. translators: 1: Plugin name, 2: Opening <a> tag to database prefix article, 3: Closing </a> tag.
#: controllers/SecurityCheck.php:347
#, php-format
msgid "%1$s protects your website from most SQL injections, but using a custom database prefix adds an extra layer of defense. %2$sLearn how to change it%3$s"
msgstr ""

#: controllers/SecurityCheck.php:351
msgid "File Permissions"
msgstr ""

#: controllers/SecurityCheck.php:355
msgid "One or more files or directories have overly permissive settings. Incorrect file permissions can allow unauthorized users to read, modify, or execute sensitive files — potentially leading to full site compromise. <br /><br />Directories should typically be set to 755 and files to 644."
msgstr ""

#. translators: 1: Plugin name, 2: Opening <a> tag to file permissions article, 3: Closing </a> tag.
#: controllers/SecurityCheck.php:357
#, php-format
msgid "Even though %1$s protects default paths after customization, we recommend verifying correct permissions for all files and directories. Use File Manager or FTP to review and adjust. %2$sRead the guide%3$s"
msgstr ""

#: controllers/SecurityCheck.php:361
msgid "Security Keys and Salts"
msgstr ""

#: controllers/SecurityCheck.php:365
msgid "WordPress security keys and salts strengthen the encryption of data stored in user cookies and hashed passwords. Without properly configured keys, session tokens and passwords are easier to crack. <br /><br />Each key should be unique, random, and at least 64 characters long."
msgstr ""

#: controllers/SecurityCheck.php:366
msgid "Define all eight security constants in wp-config.php with unique, random values: <code>AUTH_KEY, SECURE_AUTH_KEY, LOGGED_IN_KEY, NONCE_KEY, AUTH_SALT, SECURE_AUTH_SALT, LOGGED_IN_SALT, NONCE_SALT</code>"
msgstr ""

#: controllers/SecurityCheck.php:370
msgid "Security Keys Need Rotation"
msgstr ""

#: controllers/SecurityCheck.php:374
msgid "Your security keys have not been regenerated in a long time. Regularly rotating security keys invalidates all existing sessions and forces re-authentication, limiting the window of exposure if credentials are compromised."
msgstr ""

#. translators: 1: Opening <a> tag to WordPress secret key generator, 2: Closing </a> tag.
#: controllers/SecurityCheck.php:376
#, php-format
msgid "Generate %1$snew security keys%2$s and replace the existing values in wp-config.php: <code>AUTH_KEY, SECURE_AUTH_KEY, LOGGED_IN_KEY, NONCE_KEY, AUTH_SALT, SECURE_AUTH_SALT, LOGGED_IN_SALT, NONCE_SALT</code>"
msgstr ""

#: controllers/SecurityCheck.php:380
msgid "Weak Database Password"
msgstr ""

#: controllers/SecurityCheck.php:384
msgid "Your database password is empty or too simple. Even though most servers restrict database access to localhost, a weak password provides no defense if that restriction is ever bypassed or misconfigured."
msgstr ""

#: controllers/SecurityCheck.php:385
msgid "Set a strong database password — at least 12 characters with a mix of uppercase, lowercase, numbers, and special characters. Update the password in wp-config.php: <code>define('DB_PASSWORD', 'NEW_DB_PASSWORD_GOES_HERE');</code>"
msgstr ""

#. translators: 1: wp-content path.
#. translators: 1: Admin path.
#. translators: 1: Login path.
#: controllers/SecurityCheck.php:389
#: controllers/SecurityCheck.php:410
#: controllers/SecurityCheck.php:421
#, php-format
msgid "%1$s is visible in source code"
msgstr ""

#: controllers/SecurityCheck.php:393
msgid "Default WordPress paths like wp-content and wp-includes are visible in your source code. These paths confirm to bots and attackers that your site runs WordPress, making it a target for automated exploit scanners."
msgstr ""

#. translators: 1: Opening <a> tag to Core settings URL, 2: Plugin menu name, 3: Closing </a> tag.
#: controllers/SecurityCheck.php:395
#, php-format
msgid "Change default paths from %1$s%2$s > Change Paths > WP Core Security%3$s"
msgstr ""

#. translators: 1: wp-content path.
#. translators: 1: Login path.
#: controllers/SecurityCheck.php:399
#: controllers/SecurityCheck.php:432
#, php-format
msgid "%1$s path is accessible"
msgstr ""

#: controllers/SecurityCheck.php:403
msgid "The original WordPress paths are still accessible even though custom paths are set. Bots can still reach plugins and themes at their default locations, bypassing the path changes. <br /><br />Hiding old paths ensures that only the custom paths work, fully removing the original entry points."
msgstr ""

#. translators: 1: Opening <a> tag to Core settings URL, 2: Plugin menu name, 3: Closing </a> tag.
#: controllers/SecurityCheck.php:405
#, php-format
msgid "Change the default path and switch on %1$s%2$s > Change Paths > Hide WordPress Common Paths%3$s"
msgstr ""

#. translators: 1: Opening <a> tag to KB article, 2: Closing </a> tag.
#: controllers/SecurityCheck.php:415
#, php-format
msgid "Your custom admin path is exposed in the page source code (typically through the AJAX URL). This allows attackers to discover your admin path and launch targeted brute force attacks. <br /><br />%1$sLearn how to hide the admin path from source code%2$s."
msgstr ""

#. translators: 1: Opening <a> tag to AJAX settings URL, 2: Plugin menu name, 3: Closing </a> tag, 4: Opening <strong> tag, 5: Closing </strong> tag.
#: controllers/SecurityCheck.php:417
#, php-format
msgid "Change the default ajax path and switch on %1$s%2$s > Change Paths > Hide wp-admin from ajax URL%3$s. %4$sAlso verify that no installed plugins reference the admin path in frontend output.%5$s"
msgstr ""

#. translators: 1: Opening <a> tag to KB article, 2: Closing </a> tag.
#: controllers/SecurityCheck.php:426
#, php-format
msgid "Your custom login path is exposed in the page source code. This defeats the purpose of changing the login URL, as attackers can still discover it and target it with brute force attacks. <br /><br />The custom login path must be kept secret, and Brute Force Protection should be active. %1$sLearn how to hide the login path from source code%2$s."
msgstr ""

#. translators: 1: Opening <strong> tag, 2: Closing </strong> tag.
#: controllers/SecurityCheck.php:428
#, php-format
msgid "%1$sRemove the login path%2$s from any theme menus, widgets, or page content that expose it in the frontend."
msgstr ""

#: controllers/SecurityCheck.php:436
msgid "The default wp-login.php path is still accessible. Even with a custom login URL configured, bots can still find and attack the original login page. Blocking access to the default path forces all login traffic through your custom URL, where Brute Force Protection can be applied."
msgstr ""

#. translators: 1: Opening <a> tag to Custom login URL settings, 2: Plugin menu name, 3: Closing </a> tag, 4: Opening <a> tag to Brute Force settings, 5: Plugin menu name, 6: Closing </a> tag.
#: controllers/SecurityCheck.php:438
#, php-format
msgid "Set a custom login URL from %1$s%2$s > Change Paths > Custom login URL%3$s and switch on %4$s%5$s > Brute Force Protection%6$s"
msgstr ""

#: controllers/SecurityCheck.php:442
msgid "wp-config.php & wp-config-sample.php are accessible"
msgstr ""

#: controllers/SecurityCheck.php:446
msgid "Your wp-config.php file is publicly accessible. This file contains your database credentials, security keys, and other critical configuration details. If an attacker can read this file, they can gain full control of your database and website."
msgstr ""

#. translators: 1: Opening <a> tag to Core settings URL, 2: Plugin menu name, 3: Closing </a> tag.
#: controllers/SecurityCheck.php:448
#, php-format
msgid "Switch on %1$s%2$s > Change Paths > Hide WordPress Common Files%3$s"
msgstr ""

#: controllers/SecurityCheck.php:452
msgid "readme.html file is accessible"
msgstr ""

#: controllers/SecurityCheck.php:456
msgid "The readme.html file is publicly accessible and reveals your WordPress version number. Attackers use this to identify sites running versions with known vulnerabilities."
msgstr ""

#. translators: 1: Plugin menu name, 2: Opening <a> tag to Core settings URL, 3: Closing </a> tag.
#: controllers/SecurityCheck.php:458
#, php-format
msgid "Switch on %1$s > Change Paths > Hide WordPress Common Files from %2$sHide WordPress Common Paths%3$s"
msgstr ""

#: controllers/SecurityCheck.php:462
msgid "install.php & upgrade.php are accessible"
msgstr ""

#: controllers/SecurityCheck.php:466
msgid "The wp-admin/install.php and wp-admin/upgrade.php files are publicly accessible. These files have been associated with security vulnerabilities in the past and should not be reachable on a live site."
msgstr ""

#. translators: 1: Plugin menu name, 2: Opening <a> tag to Core settings URL, 3: Closing </a> tag.
#: controllers/SecurityCheck.php:468
#, php-format
msgid "Switch on %1$s > Change Paths > Hide WordPress Common Files from %2$sHide WordPress Common Paths%3$s and select also install.php & upgrade.php"
msgstr ""

#: controllers/SecurityCheck.php:472
msgid "Firewall Not Loaded"
msgstr ""

#: controllers/SecurityCheck.php:476
msgid "The firewall is not active. Without these rulesets, malicious requests, including SQL injection attempts, script injections and exploit probes, reach your site without being filtered."
msgstr ""

#. translators: 1: Opening <a> tag to Firewall settings URL, 2: Plugin menu name, 3: Closing </a> tag.
#: controllers/SecurityCheck.php:478
#, php-format
msgid "Switch on the 2026 Ghost Firewall from %1$s%2$s > Firewall & Headers%3$s"
msgstr ""

#: controllers/SecurityCheck.php:482
msgid "Automated IP Blocking Not Active"
msgstr ""

#: controllers/SecurityCheck.php:486
msgid "Automated IP Blocking is not currently active. Without this protection, repeated suspicious requests from the same IP — such as brute force probes, scanner sweeps, and exploit attempts — are not blocked automatically. This increases server load and leaves your site exposed to sustained attacks that cannot be addressed fast enough manually."
msgstr ""

#. translators: 1: Opening <a> tag to Firewall settings URL, 2: Plugin menu name, 3: Closing </a> tag.
#: controllers/SecurityCheck.php:488
#, php-format
msgid "Switch on the Automated IP Blocking option from %1$s%2$s > Firewall & Headers%3$s"
msgstr ""

#: controllers/SecurityCheck.php:492
msgid "Version Numbers Exposed"
msgstr ""

#: controllers/SecurityCheck.php:496
msgid "WordPress, plugin, and theme version numbers are visible in your source code. Attackers use version information to identify sites running software with known vulnerabilities and target them with automated exploits."
msgstr ""

#. translators: 1: Opening <a> tag to Tweaks settings URL, 2: Plugin menu name, 3: Feature label, 4: Closing </a> tag.
#: controllers/SecurityCheck.php:498
#, php-format
msgid "Switch on %1$s%2$s > Tweaks > %3$s%4$s"
msgstr ""

#. translators: 1: Opening <a> tag to Tweaks settings URL, 2: Plugin menu name, 3: Feature label, 4: Closing </a> tag.
#: controllers/SecurityCheck.php:498
msgid "Hide Versions from Images, CSS and JS"
msgstr ""

#: controllers/SecurityCheck.php:502
msgid "PHP register_globals is on"
msgstr ""

#: controllers/SecurityCheck.php:506
msgid "The register_globals PHP directive is enabled. This is a critical security risk — it allows external input to overwrite internal PHP variables, enabling attackers to manipulate your application logic. This directive has been removed in modern PHP versions due to its severity."
msgstr ""

#: controllers/SecurityCheck.php:507
msgid "Set <code>register_globals = off</code> in php.ini, or contact your hosting provider to disable it immediately. Consider switching hosts if they enable this by default."
msgstr ""

#: controllers/SecurityCheck.php:510
msgid "PHP Version Exposed"
msgstr ""

#: controllers/SecurityCheck.php:514
msgid "Your server is broadcasting its PHP version in HTTP response headers. This information helps attackers identify which PHP vulnerabilities may apply to your server."
msgstr ""

#: controllers/SecurityCheck.php:515
msgid "Set <code>expose_php = off</code> in php.ini, or contact your hosting provider to disable it."
msgstr ""

#: controllers/SecurityCheck.php:518
msgid "PHP safe_mode is on"
msgstr ""

#: controllers/SecurityCheck.php:522
msgid "PHP safe_mode is enabled on your server. This deprecated directive was an attempt to solve shared hosting security at the PHP level but was architecturally flawed and officially removed in PHP 5.4. <br /><br />When enabled, it can break legitimate PHP functions while providing no real protection — attackers can easily bypass its restrictions."
msgstr ""

#: controllers/SecurityCheck.php:523
msgid "Set <code>safe_mode = off</code> in php.ini, or contact your hosting provider to disable it. If your host requires safe_mode, consider migrating to a modern hosting environment."
msgstr ""

#: controllers/SecurityCheck.php:526
msgid "PHP allow_url_include is on"
msgstr ""

#: controllers/SecurityCheck.php:530
msgid "The allow_url_include PHP directive is enabled. This allows PHP to include remote files via URLs in include/require statements, exposing your site to Remote File Inclusion (RFI) attacks where attackers can execute arbitrary code on your server."
msgstr ""

#: controllers/SecurityCheck.php:531
msgid "Set <code>allow_url_include = off</code> in php.ini, or contact your hosting provider to disable it. There is no legitimate use case for this directive on production sites."
msgstr ""

#: controllers/SecurityCheck.php:534
msgid "Plugin/Theme Editor Enabled"
msgstr ""

#: controllers/SecurityCheck.php:538
msgid "The built-in plugin and theme file editor is active. If an attacker gains admin access, they can use this editor to inject malicious PHP code directly into your site files — instantly compromising the entire installation without needing FTP or server access."
msgstr ""

#: controllers/SecurityCheck.php:539
msgid "Add the following to wp-config.php to disable the file editor: <code>define('DISALLOW_FILE_EDIT', true);</code>"
msgstr ""

#. translators: 1: Folder path.
#: controllers/SecurityCheck.php:544
#, php-format
msgid "%1$s directory is browsable"
msgstr ""

#: controllers/SecurityCheck.php:548
msgid "Directory browsing is enabled on your uploads folder. Anyone can view and download all uploaded files by navigating to the directory URL — this is both a security risk and a copyright concern."
msgstr ""

#. translators: 1: Opening <a> tag to external directory browsing article, 2: Closing </a> tag, 3: Opening <a> tag to Core settings URL, 4: Plugin menu name, 5: Closing </a> tag.
#: controllers/SecurityCheck.php:550
#, php-format
msgid "Learn how to %1$sdisable directory browsing%2$s, or switch on %3$s%4$s > Change Paths > Disable Directory Browsing%5$s"
msgstr ""

#: controllers/SecurityCheck.php:554
msgid "Windows Live Writer Link Exposed"
msgstr ""

#: controllers/SecurityCheck.php:558
msgid "The Windows Live Writer manifest link is present in your page header. This is a WordPress-specific fingerprint that confirms your CMS to automated scanners. Since Windows Live Writer is discontinued, there is no reason to keep this enabled."
msgstr ""

#. translators: 1: Opening <a> tag to Tweaks settings URL, 2: Plugin menu name, 3: Closing </a> tag.
#: controllers/SecurityCheck.php:560
#, php-format
msgid "Switch on %1$s%2$s > Tweaks > Hide WLW Manifest scripts%3$s"
msgstr ""

#: controllers/SecurityCheck.php:564
msgid "XML-RPC Access Enabled"
msgstr ""

#: controllers/SecurityCheck.php:568
msgid "XML-RPC is currently accessible. This protocol sends credentials in plain text with every request and supports system.multicall, which allows attackers to test thousands of passwords in a single HTTP request. Unless you specifically need XML-RPC for remote publishing or the Jetpack plugin, it should be disabled."
msgstr ""

#. translators: 1: Opening <a> tag to API settings URL, 2: Plugin menu name, 3: Closing </a> tag.
#: controllers/SecurityCheck.php:570
#, php-format
msgid "Disable XML-RPC from %1$s%2$s > Change Paths > Disable XML-RPC access%3$s"
msgstr ""

#: controllers/SecurityCheck.php:574
msgid "RSD Endpoint Exposed"
msgstr ""

#: controllers/SecurityCheck.php:578
msgid "The Really Simple Discovery (RSD) endpoint link is visible in your page header. Unless you use pingbacks or external blog clients that rely on RSD, this link serves no purpose and acts as a WordPress fingerprint that confirms your CMS to scanners."
msgstr ""

#. translators: 1: Opening <a> tag to API settings URL, 2: Plugin menu name, 3: Closing </a> tag.
#: controllers/SecurityCheck.php:580
#, php-format
msgid "Switch on %1$s%2$s > Change Paths > Hide RSD Endpoint%3$s"
msgstr ""

#: controllers/SecurityCheck.php:584
msgid "Author URL Enumeration via ID"
msgstr ""

#: controllers/SecurityCheck.php:588
msgid "Usernames can be discovered by iterating through author IDs (e.g., /?author=1, /?author=2). WordPress redirects valid IDs to the author archive URL, revealing the username. <br /><br />While usernames alone don't grant access, they provide attackers with half the credentials needed and enable targeted brute force or phishing attacks."
msgstr ""

#. translators: 1: Opening <a> tag to Author settings URL, 2: Plugin menu name, 3: Closing </a> tag.
#: controllers/SecurityCheck.php:590
#, php-format
msgid "Switch on %1$s%2$s > Change Paths > Hide Author ID URL%3$s"
msgstr ""

#: controllers/SecurityCheck.php:594
msgid "User Enumeration via REST API"
msgstr ""

#: controllers/SecurityCheck.php:598
msgid "Usernames are discoverable through the WordPress REST API (e.g., /wp-json/wp/v2/users). This endpoint can expose author IDs, display names, and author slugs — which often match or closely resemble the actual login username. <br /><br />Attackers use this information for targeted brute force attacks and phishing campaigns."
msgstr ""

#. translators: 1: Opening <a> tag to Author settings URL, 2: Plugin menu name, 3: Closing </a> tag.
#: controllers/SecurityCheck.php:600
#, php-format
msgid "Switch on %1$s%2$s > Change Paths > Hide User Enumeration%3$s"
msgstr ""

#: controllers/SecurityCheck.php:604
msgid "Default WordPress Tagline"
msgstr ""

#: controllers/SecurityCheck.php:608
msgid "Your site is still using the default WordPress tagline \"Just another WordPress site\". This is a well-known WordPress fingerprint that makes it easy for bots and scanners to confirm your CMS. It also appears unprofessional to visitors."
msgstr ""

#. translators: 1: Opening <strong> tag and Settings label, 2: General label, 3: Tagline label with closing </strong> tag.
#: controllers/SecurityCheck.php:610
#, php-format
msgid "Update your tagline in %1$s > %2$s > %3$s"
msgstr ""

