#: controllers/SecurityCheck.php:218
msgid "PHP Version"
msgstr ""

#. translators: 1: Required PHP version number.
#: controllers/SecurityCheck.php:223
#, php-format
msgid "Your server is running an outdated version of PHP. Older PHP versions no longer receive security patches, leaving your site exposed to known vulnerabilities and reducing overall performance. <br /><br />Your website requires <strong>PHP %1$s</strong> or higher."
msgstr ""

#: controllers/SecurityCheck.php:224
msgid "Contact your hosting provider and request an upgrade to a supported PHP version, or migrate to a host that offers current PHP releases."
msgstr ""

#: controllers/SecurityCheck.php:227
msgid "PHP2Shell vulnerability in PHP"
msgstr ""

#. translators: 1: Plugin name.
#: controllers/SecurityCheck.php:232
#, php-format
msgid "PHP2Shell (CVE-2026-109618 and CVE-2026-109619) is a critical flaw in PHP itself. Crafted requests can let an attacker run code on the server. The attack runs before WordPress loads, so no WordPress plugin can block it, %1$s included. <br /><br />PHP fixed it on 21 October 2026 in <strong>PHP 8.5.12, 8.4.27, 8.3.36 and 8.2.35</strong>. PHP 8.1 and older get no official update. <br /><br />Some hosts install the fix and keep the old version number. If your host confirms the fix is installed, ignore this task."
msgstr ""

#: controllers/SecurityCheck.php:233
msgid "Ask your hosting provider to update PHP to 8.5.12, 8.4.27, 8.3.36 or 8.2.35 and restart PHP. Until then, ask them to set <code>session.upload_progress.enabled = 0</code> in php.ini or in the PHP-FPM pool."
msgstr ""

#: controllers/SecurityCheck.php:236
msgid "MySQL Version"
msgstr ""

#. translators: 1: Required MySql version number, 2: Required MyMariaDBsql version number.
#: controllers/SecurityCheck.php:241
#, php-format
msgid "Your server is running an outdated version of MySQL. Unsupported MySQL versions contain known security vulnerabilities and may cause performance issues. <br /><br />Your website requires minimum <strong>MySQL %1$s or MariaDB %2$s</strong>."
msgstr ""

#: controllers/SecurityCheck.php:242
msgid "Contact your hosting provider and request an upgrade to a supported MySQL version, or migrate to a host that offers current database releases."
msgstr ""

#: controllers/SecurityCheck.php:245
msgid "WordPress Version"
msgstr ""

#. translators: 1: Opening <a> tag to WordPress download page, 2: Closing </a> tag.
#: controllers/SecurityCheck.php:250
#, php-format
msgid "A newer version of WordPress is available. Each release includes security patches and bug fixes that protect your site against newly discovered threats. <br /><br />Always update to the %1$slatest stable version%2$s as soon as it becomes available. You will see an update notice in your WordPress dashboard when a new version is ready."
msgstr ""

#: controllers/SecurityCheck.php:251
msgid "There is a newer version of WordPress available ({version})."
msgstr ""

#: controllers/SecurityCheck.php:254
msgid "WP Debug Mode"
msgstr ""

#: controllers/SecurityCheck.php:258
msgid "WP_DEBUG is currently enabled. While useful during development, leaving debug mode active on a live site exposes error messages, file paths, and internal details to visitors — information that attackers can use to identify vulnerabilities."
msgstr ""

#: controllers/SecurityCheck.php:259
msgid "Set WP_DEBUG to false in wp-config.php: <code>define('WP_DEBUG', false);</code>"
msgstr ""

#: controllers/SecurityCheck.php:263
msgid "DB Debug Mode"
msgstr ""

#: controllers/SecurityCheck.php:267
msgid "Database debug mode is currently enabled. On a live site, this can expose database error messages containing table names, query structures, and other sensitive information to visitors and potential attackers."
msgstr ""

#: controllers/SecurityCheck.php:268
msgid "Disable database debugging on live sites. You can suppress database errors by adding <code>global $wpdb; $wpdb->hide_errors();</code> in wp-config.php."
msgstr ""

#: controllers/SecurityCheck.php:272
msgid "Script Debug Mode"
msgstr ""

#: controllers/SecurityCheck.php:276
msgid "SCRIPT_DEBUG is currently enabled. This forces WordPress to load unminified CSS and JS files, which can reveal internal paths and debug information in the frontend — giving attackers insight into your site structure."
msgstr ""

#: controllers/SecurityCheck.php:277
msgid "Set SCRIPT_DEBUG to false in wp-config.php: <code>define('SCRIPT_DEBUG', false);</code>"
msgstr ""

#: controllers/SecurityCheck.php:281
msgid "display_errors PHP directive"
msgstr ""

#: controllers/SecurityCheck.php:285
msgid "The display_errors PHP directive is enabled. PHP errors displayed on the frontend can reveal file paths, function names, and database details — all of which help attackers map your site. Errors should be logged server-side, never shown to visitors."
msgstr ""

#: controllers/SecurityCheck.php:286
msgid "Add the following to wp-config.php: <code>ini_set('display_errors', 0);</code>"
msgstr ""

#: controllers/SecurityCheck.php:289
msgid "Backend under SSL"
msgstr ""

#: controllers/SecurityCheck.php:293
msgid "Your admin dashboard is not served over HTTPS. Without SSL/TLS encryption, login credentials and session data are transmitted in plain text, making them vulnerable to interception. <br /><br />An SSL certificate is essential for securing all admin communications."
msgstr ""

#. translators: 1: Opening <strong> tag before "Settings", 2: Closing </strong> tag after "General", 3: Opening anchor tag to HTTPS guide article, 4: Closing anchor tag.
#: controllers/SecurityCheck.php:295
#, php-format
msgid "Go to %1$s > %2$s and make sure <strong>WordPress Address</strong> starts with <strong>https://</strong>. %3$sRead the guide%4$s"
msgstr ""

#: controllers/SecurityCheck.php:298
msgid "User 'admin' or 'administrator' as Administrator"
msgstr ""

#: controllers/SecurityCheck.php:302
msgid "An administrator account is using the default username 'admin' or 'administrator'. These are the first usernames attackers try during brute force attacks. Since the username is half of the login credentials, using a predictable one significantly reduces the effort needed to compromise your site."
msgstr ""

#: controllers/SecurityCheck.php:303
msgid "Create a new administrator account with a unique username, transfer ownership of existing content, then delete the 'admin' or 'administrator' account."
msgstr ""

#: controllers/SecurityCheck.php:307
msgid "Spammers can easily signup"
msgstr ""

#: controllers/SecurityCheck.php:311
msgid "Public user registration is enabled. Unless your site requires it (e-commerce, memberships, or guest posting), open registration invites spam accounts, fake content, and potential exploitation of authenticated-user vulnerabilities. <br /><br />If registration is needed, protect the form with Brute Force protection."
msgstr ""

#. translators: 1: Opening <a> tag to Custom Register URL settings, 2: Plugin menu name, 3: Closing </a> tag, 4: Opening <a> tag to Brute Force settings, 5: Plugin menu name, 6: Closing </a> tag, 7: Opening <strong> tag with Settings label, 8: General label, 9: Anyone can register label with closing </strong> tag.
#: controllers/SecurityCheck.php:313
#, php-format
msgid "Change the signup path from %1$s%2$s > Change Paths > Custom Register URL %3$s then activate Brute Force on Sign up from %4$s%5$s > Brute Force > Settings %6$s or uncheck the option %7$s > %8$s > %9$s"
msgstr ""

#. translators: 1: Opening <a> tag to Custom Register URL settings, 2: Plugin menu name, 3: Closing </a> tag, 4: Opening <a> tag to Brute Force settings, 5: Plugin menu name, 6: Closing </a> tag, 7: Opening <strong> tag with Settings label, 8: General label, 9: Anyone can register label with closing </strong> tag.
#: controllers/SecurityCheck.php:313
msgid "General"
msgstr ""

